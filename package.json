{
  "name": "@haensl/iso-log",
  "version": "3.1.0",
  "description": "Isomorphic logger with Bunyan and Sentry support.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "main": "./index.cjs",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint '**/*.js'",
    "lint:junit": "eslint --format junit -o test-results/eslint/results.xml '**/*.js'",
    "precommit": "npm run lint && npm test",
    "setup": "./setup-hooks.sh",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --no-cache --colors --passWithNoTests",
    "test:junit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --no-cache --ci --reporters='default' --reporters='jest-junit' --passWithNoTests",
    "tdd": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --colors --watch"
  },
  "jest": {
    "globals": {
      "NODE_ENV": "test"
    },
    "testEnvironment": "node",
    "transform": {},
    "modulePathIgnorePatterns": [
      "package.test"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "jest-junit": {
    "outputDirectory": "test-results/jest",
    "outputName": "results.xml",
    "suitName": "@haensl/iso-log unit tests"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/haensl/iso-log.git"
  },
  "keywords": [
    "isomorphic",
    "log",
    "bunyan",
    "sentry",
    "console"
  ],
  "author": {
    "name": "HP Dietz",
    "url": "https://hpdietz.com",
    "email": "h.p.dietz@gmail.com"
  },
  "funding": "https://github.com/sponsors/haensl",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/haensl/iso-log/issues"
  },
  "homepage": "https://github.com/haensl/iso-log#readme",
  "files": [
    "index.mjs",
    "index.cjs",
    "iso-log.js"
  ],
  "dependencies": {
    "@haensl/log": "^1.3.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@haensl/eslint-config": "^2.0.0",
    "eslint": "^10.4.0",
    "eslint-formatter-junit": "^9.0.1",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0"
  }
}
